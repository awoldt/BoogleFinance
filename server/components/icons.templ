package components

templ searchIcon(class string) {
	<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class={ class }>
		<circle cx="11" cy="11" r="6.25" stroke="currentColor" stroke-width="2"></circle>
		<path d="M16 16.5 20 20.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
	</svg>
}

templ plusIcon(class string) {
	<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class={ class }>
		<path d="M12 6.5v11M6.5 12h11" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
	</svg>
}

templ checkIcon(class string) {
	<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class={ class }>
		<path d="M6.5 12.5 10.2 16 17.5 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
	</svg>
}

templ backIcon(class string) {
	<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class={ class }>
		<path d="M15 5.5 8.5 12l6.5 6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
	</svg>
}

templ listIcon(class string) {
	<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class={ class }>
		<path d="M8 7h11M8 12h11M8 17h11" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
		<circle cx="4.5" cy="7" r="1" fill="currentColor"></circle>
		<circle cx="4.5" cy="12" r="1" fill="currentColor"></circle>
		<circle cx="4.5" cy="17" r="1" fill="currentColor"></circle>
	</svg>
}

templ sunIcon(class string) {
	<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class={ class }>
		<circle cx="12" cy="12" r="3.25" stroke="currentColor" stroke-width="1.7"></circle>
		<path d="M12 3.5v2.2M12 18.3v2.2M3.5 12h2.2M18.3 12h2.2M6 6l1.6 1.6M16.4 16.4 18 18M18 6l-1.6 1.6M7.6 16.4 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
	</svg>
}

templ moonIcon(class string) {
	<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class={ class }>
		<path d="M15.5 3.8A7.8 7.8 0 1 0 20.2 14 6.2 6.2 0 0 1 15.5 3.8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
	</svg>
}

// arrowIcon points down for a negative change, up otherwise
templ arrowIcon(change float64) {
	<svg viewBox="0 0 12 12" class="h-3 w-3" fill="none" aria-hidden="true">
		if change < 0 {
			<path d="M6 2.5v7M6 9.5 3 6.5M6 9.5l3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
		} else {
			<path d="M6 9.5V2.5M6 2.5 3 5.5M6 2.5l3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
		}
	</svg>
}
